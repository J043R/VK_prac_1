  "label": "bench-first",
  "sql": "SELECT c.name, c.custkey, o.orderkey, o.orderdate, o.totalprice,\n    sum(l.quantity) AS total_quantity\n    FROM lakekeeper.bench_20261015165153_parquet_snappy.customer c\n    JOIN lakekeeper.bench_20261015165153_parquet_snappy.orders o ON c.custkey=o.custkey\n    JOIN lakekeeper.bench_20261015165153_parquet_snappy.lineitem l ON o.orderkey=l.orderkey\n    WHERE o.orderkey IN (SELECT orderkey FROM lakekeeper.bench_20261015165153_parquet_snappy.lineitem\n      GROUP BY orderkey HAVING sum(quantity)>300)\n    GROUP BY c.name,c.custkey,o.orderkey,o.orderdate,o.totalprice\n    ORDER BY o.totalprice DESC,o.orderdate,o.orderkey LIMIT 100",
